; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be created manually.

config_version=5

[application]

config/name="うみかぜ日和"
config/description="うみかぜ日和 〜 日本全国お魚釣り旅：福岡・糸島編 〜"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.91, 0.96, 0.93, 1)

[autoload]

GameData="*res://scripts/autoload/GameData.gd"
SoundManager="*res://scripts/autoload/SoundManager.gd"

[debug]

file_logging/enable_file_logging=false

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/ZenMaruGothic-Medium.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.91, 0.96, 0.93, 1)
