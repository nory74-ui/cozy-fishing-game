text = "閉じる"

[node name="Scroll" type="ScrollContainer" parent="CanvasLayer/HelpModal/Card/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="ContentVBox" type="VBoxContainer" parent="CanvasLayer/HelpModal/Card/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Step1" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.3, 0.35, 1)
theme_override_font_sizes/font_size = 15
text = "1. 探索しよう！
【WASD】または【矢印キー】でデフォルメされたおじさんを移動。
小川、池、滝壺など、魚たちが泳ぐ水辺を探そう！"
autowrap_mode = 3

[node name="Step2" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.3, 0.35, 1)
theme_override_font_sizes/font_size = 15
text = "2. 魚影を狙ってキャスト！
水辺の魚影の近くにマウスカーソルを合わせ、【左クリック】でウキを投げ入れます。
魚がウキをつつき、激しく沈んだ【HIT!!】の瞬間にすかさずクリック！"
autowrap_mode = 3

[node name="Step3" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.3, 0.35, 1)
theme_override_font_sizes/font_size = 15
text = "3. リール巻き上げミニゲーム！
魚がかかったらファイト開始！ 【マウス左ボタンを長押し】すると緑の枠が右へ動きます。
暴れる魚を緑枠の中にキープし続け、進行度ゲージを100%まで溜めるとキャッチ！"
autowrap_mode = 3

[node name="Step4" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.3, 0.35, 1)
theme_override_font_sizes/font_size = 15
text = "4. よろず屋で道具を手に入れて開拓！
釣った魚をショップで売ってコインを獲得！
・ゴム長靴: 川の南の浅瀬をジャブジャブ渡り「西の原生林」へ！
・木こりのオノ: 北の倒木を切り払い「秘密のエメラルド滝壺」へ！
・手漕ぎボート: 湖を漕ぎ出して中央の「神秘の孤島」へ！
強力な釣り竿や良いエサも購入して、大物や主を狙おう！"
autowrap_mode = 3

[node name="Step5" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.3, 0.35, 1)
theme_override_font_sizes/font_size = 15
text = "5. お魚図鑑をコンプリートしよう！
全8種類の実在魚を発見しよう！ 【Bキー】または画面左上のボタンでいつでも開けます。
同じ魚でも大物を釣り上げると自己ベスト記録が更新されるぞ！"
autowrap_mode = 3

