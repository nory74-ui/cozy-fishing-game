[node name="Scroll" type="ScrollContainer" parent="CanvasLayer/HelpModal/Card/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="ContentVBox" type="VBoxContainer" parent="CanvasLayer/HelpModal/Card/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="Step1" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.28, 0.35, 1)
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 14
text = "【1. 大波止・白砂サーフを歩こう】
【WASD】または【矢印キー】で移動。
野北漁港の白い大波止の上、先端の常夜灯、なだらかなスロープから野北サーフの砂浜まで自由に歩き回れます。"
autowrap_mode = 3

[node name="Step2" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.28, 0.35, 1)
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 14
text = "【2. 海面を狙ってキャスト】
海面をクリックすると、竿を振って仕掛け（ウキ）を投げ込みます。
投げ直したいときは【右クリック】で瞬時に仕掛けを回収できます。"
autowrap_mode = 3

[node name="Step3" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.28, 0.35, 1)
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 14
text = "【3. アタリとリールファイト】
透明な水中から魚が寄ってきてウキをつつきます。
ウキが沈み込み【HIT!!】が出たら、すかさず左クリック！
リールミニゲームが始まったら、左クリック長押しで緑のバーを動かし、魚のアイコンを捉え続けよう！"
autowrap_mode = 3

[node name="Step4" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.28, 0.35, 1)
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 14
text = "【4. エサの変更・釣具店】
【E】キーで所持しているエサ（アオイソメ、生オキアミ、ムール貝、活きエビ等）を瞬時に切り替え。
【K】キーまたは波止の案内看板をクリックすると「釣具・エサ店」が開き、魚の売却や新しい竿・エサを購入できます。"
autowrap_mode = 3

[node name="Step5" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.28, 0.35, 1)
theme_override_fonts/font = ExtResource("3_font")
theme_override_font_sizes/font_size = 14
text = "【5. 図鑑とセーブ】
【Tab】キーで「玄界灘・糸島 お魚図鑑」を開き、全10種の実在魚の生態や最大サイズ記録を閲覧できます。
ゲーム画面右上の「セーブ」ボタンでいつでも手動セーブが可能です。"
autowrap_mode = 3

