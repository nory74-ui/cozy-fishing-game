text = "3. 【ファイト＆クローズアップ】 ヒット中は [Space] / [E] でリールを巻き、張力ゲージが赤に寄りすぎたら一瞬緩めましょう。釣れると近くで観賞できます。"
autowrap_mode = 3

[node name="Step4" type="Label" parent="CanvasLayer/HelpModal/Card/VBox/Scroll/ContentVBox"]
