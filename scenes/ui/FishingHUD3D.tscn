theme_override_colors/font_color = Color(0.85, 0.88, 0.92, 1)
theme_override_font_sizes/font_size = 13
text = "スズキ目スズキ科。日本沿岸の固有種で、セイゴ→フッコ→スズキと成長に伴い名を変える出世魚。白波が砕け散る大波止の外海サラシや潮流帯を好み、イワシやコノシロを果敢に追尾する。針掛かりすると激しく水面を割って大口を開け頭を振る「エラ洗い（鰓洗い）」で針を外そうとする。"
horizontal_alignment = 1
autowrap_mode = 3

